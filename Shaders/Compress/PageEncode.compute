// 压缩通路：每个线程把 scratch 的一块编码为 64 / 128 位，写入对应 UInt 块图。
// 颜色层先把线性值转成 sRGB 再编码（物理图为 *_SRGB 格式）；数据层原样编码。

#pragma kernel EncodeBC1
#pragma kernel EncodeBC5
#pragma kernel EncodeBC3
#pragma kernel EncodeETC2RGB
#pragma kernel EncodeETC2
#pragma kernel EncodeASTC

#include "BCCompress.hlsl"
#include "ETCCompress.hlsl"
#include "ASTCCompress.hlsl"

Texture2D<float4> _Source;
RWTexture2D<uint4> _Blocks;
RWTexture2D<uint2> _Blocks64;
uint _BlockCount;     // 每边块数
uint _SourceIsColor;  // 1：颜色层
uint4 _AstcBlockConfig;  // 块边长、网格宽、网格高、块模式
uint4 _AstcIseConfig;    // 权重 ISE 方式与位数、端点 ISE 方式与位数
uint2 _AstcPlaneConfig;  // 是否双平面、权重流总位数

float3 LinearToSrgb(float3 c)
{
    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(c, 1.0 / 2.4) - 0.055;
}

float4 LoadTexel(uint2 texel)
{
    float4 c = saturate(_Source.Load(int3(texel, 0)));
    if (_SourceIsColor != 0) { c.rgb = LinearToSrgb(c.rgb); }
    return c;
}

void LoadBlock4x4(uint2 block, out float3 rgb[16], out float alpha[16])
{
    [unroll] for (uint i = 0; i < 16; ++i)
    {
        float4 c = LoadTexel(block * 4 + uint2(i % 4, i / 4));
        rgb[i] = c.rgb;
        alpha[i] = c.a;
    }
}

[numthreads(8, 8, 1)]
void EncodeBC1(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }
    float3 rgb[16]; float alpha[16];
    LoadBlock4x4(id.xy, rgb, alpha);
    _Blocks64[id.xy] = CompressBC1Block(rgb);
}

[numthreads(8, 8, 1)]
void EncodeBC5(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }
    float x[16], y[16];
    [unroll] for (uint i = 0; i < 16; ++i)
    {
        float4 texel = LoadTexel(id.xy * 4 + uint2(i % 4, i / 4));
        x[i] = texel.a;
        y[i] = texel.g;
    }
    _Blocks[id.xy] = uint4(CompressBC4Block(x), CompressBC4Block(y));
}

[numthreads(8, 8, 1)]
void EncodeETC2RGB(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }
    float3 rgb[16]; float alpha[16];
    LoadBlock4x4(id.xy, rgb, alpha);
    _Blocks64[id.xy] = CompressBlock_ETC2_RGB(rgb);
}

[numthreads(8, 8, 1)]
void EncodeBC3(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }
    float3 rgb[16]; float alpha[16];
    LoadBlock4x4(id.xy, rgb, alpha);
    _Blocks[id.xy] = CompressBC3Block(rgb, alpha);
}

[numthreads(8, 8, 1)]
void EncodeETC2(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }
    float3 rgb[16]; float alpha[16];
    LoadBlock4x4(id.xy, rgb, alpha);
    _Blocks[id.xy] = CompressBlock_ETC2_RGBA(rgb, alpha);
}

[numthreads(4, 4, 1)]
void EncodeASTC(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _BlockCount)) { return; }

    AstcConfig config;
    config.blockSize = _AstcBlockConfig.x;
    config.gridWidth = _AstcBlockConfig.y;
    config.gridHeight = _AstcBlockConfig.z;
    config.blockMode = _AstcBlockConfig.w;
    config.weightKind = _AstcIseConfig.x;
    config.weightBits = _AstcIseConfig.y;
    config.endpointKind = _AstcIseConfig.z;
    config.endpointBits = _AstcIseConfig.w;
    config.dualPlane = _AstcPlaneConfig.x;
    config.weightStreamBits = _AstcPlaneConfig.y;

    uint size = config.blockSize;
    for (uint t = 0; t < size; ++t)
    {
        for (uint s = 0; s < size; ++s) { s_AstcTexels[t * size + s] = LoadTexel(id.xy * size + uint2(s, t)) * 255.0; }
    }
    _Blocks[id.xy] = CompressBlock_ASTC(config);
}
